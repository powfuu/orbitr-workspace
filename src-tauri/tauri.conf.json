{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbitr Workspace",
  "version": "0.1.0",
  "identifier": "dev.orbitr.workspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Orbitr Workspace",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#000000",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Your agents. Your terminals. One workspace.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZENDEyMjBGNzJFMTk2NUIKUldSYmx1RnlEeUpCL1hETE52eU9QQWpsWHdQVEZJMEU1bDhEL1RCaDE5RS9hWHJwdU9iSUFsWmYK",
      "endpoints": [
        "https://github.com/powfuu/orbitr-workspace/releases/latest/download/latest.json"
      ]
    }
  }
}
